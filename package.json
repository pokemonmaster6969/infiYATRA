{
  "name": "infiland",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "browserslist": [
    "Chrome >= 105",
    "Edge >= 105",
    "Firefox >= 115",
    "Safari >= 16.4"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "seed": "tsx scripts/seed.ts",
    "validate:packages": "tsx scripts/validate-packages.ts",
    "images:fetch": "tsx scripts/fetch-images.ts",
    "images:optimize": "node scripts/optimize-public-images.mjs",
    "preview": "vite preview",
    "server": "node server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
